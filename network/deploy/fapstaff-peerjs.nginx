server {
    listen 80;
    listen [::]:80;
    server_name fapstaff.com;

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name fapstaff.com;
    root /var/www/herdr-v86/current;
    index index.html;

    # Emit relative redirects. nginx builds absolute ones from its own listen
    # scheme, which is correct here but wrong the moment this sits behind a
    # proxy that terminates TLS upstream: every redirect comes back as http://
    # and an https page blocks it as mixed content. /peerjs -> /peerjs/ broke
    # exactly that way. Harmless with TLS terminated locally, so it belongs in
    # both configurations rather than only the proxied one.
    absolute_redirect off;
    port_in_redirect off;

    ssl_certificate /etc/letsencrypt/live/fapstaff.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/fapstaff.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location = /app.webmanifest {
        default_type application/manifest+json;
        add_header Cache-Control "no-cache";
    }

    location = /ide {
        return 301 /ide/;
    }

    # Public preview for the single running Dev VM. The owner must keep the
    # VMVM tab open because that page owns the emulator and its network tunnel.
    location /ide/ {
        proxy_pass http://10.77.0.15:3000/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 300s;
        add_header Cache-Control "no-store";
    }

    # The scaffolded app server inside the Dev VM runs on its own port; the IDE
    # shell embeds it as the live preview iframe at /preview/.
    location = /preview {
        return 301 /preview/;
    }

    location /preview/ {
        proxy_pass http://10.77.0.15:3100/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 300s;
        add_header Cache-Control "no-store";
    }

    location = /v1/sessions {
        proxy_pass http://127.0.0.1:8086;
        proxy_set_header Host $host;
        proxy_set_header Origin $http_origin;
    }

    location = /v1/ethernet {
        proxy_pass http://127.0.0.1:8086;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header Origin $http_origin;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    location = /plu {
        return 301 /plu/;
    }

    location /plu/ {
        proxy_pass http://127.0.0.1:8081/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Accept-Encoding "";
        proxy_redirect ~^/(.*)$ /plu/$1;
        sub_filter_once off;
        sub_filter 'action="/"' 'action="/plu/"';
    }

    location /peerjs/ {
        proxy_pass http://127.0.0.1:9000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 75s;
        proxy_send_timeout 75s;
        proxy_buffering off;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    location = /service-worker.js {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    location = /downloads/moonshine-tiny-quantized-0.1.29.zip {
        alias /var/www/herdr-v86-downloads/moonshine-tiny-quantized-0.1.29.zip;
        default_type application/zip;
        add_header Content-Disposition 'attachment; filename="moonshine-tiny-quantized-0.1.29.zip"';
    }

    location ~ \.mjs$ {
        default_type application/javascript;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name avirads.com www.avirads.com;
    return 301 https://fapstaff.com$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name avirads.com www.avirads.com;

    ssl_certificate /etc/letsencrypt/live/avirads.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/avirads.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    return 301 https://fapstaff.com$request_uri;
}
