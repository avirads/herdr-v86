server {
    listen 80;
    listen [::]:80;
    server_name fapstaff.com;

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name fapstaff.com;
    root /var/www/herdr-v86/current;
    index index.html;

    # Emit relative redirects. nginx builds absolute ones from its own listen
    # scheme, which is correct here but wrong the moment this sits behind a
    # proxy that terminates TLS upstream: every redirect comes back as http://
    # and an https page blocks it as mixed content. /peerjs -> /peerjs/ broke
    # exactly that way. Harmless with TLS terminated locally, so it belongs in
    # both configurations rather than only the proxied one.
    absolute_redirect off;
    port_in_redirect off;

    ssl_certificate /etc/letsencrypt/live/fapstaff.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/fapstaff.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location = /app.webmanifest {
        default_type application/manifest+json;
        add_header Cache-Control "no-cache";
    }

    location = /ide {
        return 301 /ide/;
    }

    # Public preview for the single running Dev VM. The owner must keep the
    # VMVM tab open because that page owns the emulator and its network tunnel.
    location /ide/ {
        proxy_pass http://10.77.0.15:3000/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 300s;
        add_header Cache-Control "no-store";
    }

    # The scaffolded app server inside the Dev VM runs on its own port; the IDE
    # shell embeds it as the live preview iframe at /preview/.
    location = /preview {
        return 301 /preview/;
    }

    location /preview/ {
        proxy_pass http://10.77.0.15:3100/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 300s;
        add_header Cache-Control "no-store";
    }

    location = /v1/sessions {
        proxy_pass http://127.0.0.1:8086;
        proxy_set_header Host $host;
        proxy_set_header Origin $http_origin;
    }

    location = /v1/ethernet {
        proxy_pass http://127.0.0.1:8086;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header Origin $http_origin;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    location = /plu {
        return 301 /plu/;
    }

    location /plu/ {
        proxy_pass http://127.0.0.1:8081/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Accept-Encoding "";
        proxy_redirect ~^/(.*)$ /plu/$1;
        sub_filter_once off;
        sub_filter 'action="/"' 'action="/plu/"';
    }

    location /peerjs/ {
        proxy_pass http://127.0.0.1:9000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 75s;
        proxy_send_timeout 75s;
        proxy_buffering off;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    location = /service-worker.js {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    location = /downloads/moonshine-tiny-quantized-0.1.29.zip {
        alias /var/www/herdr-v86-downloads/moonshine-tiny-quantized-0.1.29.zip;
        default_type application/zip;
        add_header Content-Disposition 'attachment; filename="moonshine-tiny-quantized-0.1.29.zip"';
    }

    location ~ \.mjs$ {
        default_type application/javascript;
        try_files $uri =404;
    }

    # CheerpX provider. CheerpX needs SharedArrayBuffer, so this route must be
    # cross-origin isolated — and the isolation is scoped HERE rather than
    # applied server-wide on purpose: COEP require-corp on "/" would break the
    # v86 page's PeerJS remote chat, the Moonshine voice model, and the AutoBro
    # extension bridge, none of which send CORP headers.
    location /cx/ {
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Cross-Origin-Embedder-Policy "require-corp" always;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ =404;
    }

    # The preview service worker controls /cx/preview/, so it must be allowed a
    # scope above its own directory.
    location = /cx/preview-sw.js {
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Cross-Origin-Embedder-Policy "require-corp" always;
        add_header Service-Worker-Allowed "/cx/" always;
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    # The vendored CheerpX engine. Immutable per version -- the version is in
    # the path -- so it may be cached hard. Do not "simplify" this by pointing
    # /cx/ back at cxrtnc.leaningtech.com: serving the engine from our own
    # origin is what lets the page work without that CDN.
    location /vendor/cheerpx/ {
        add_header Cross-Origin-Resource-Policy "same-origin" always;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Application JavaScript, as opposed to the versioned vendor tree above.
    # Without an explicit policy nginx sends neither Cache-Control nor Expires,
    # so browsers fall back to heuristic caching and keep serving a stale copy
    # after a deploy -- which is exactly how a vendored-engine deploy appeared
    # to have no effect while the page went on loading the old CDN import.
    # no-cache means revalidate, not "do not store": the ETag still turns the
    # follow-up request into a 304.
    location ~ ^/(providers|shared|llm)/ {
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    # v86 disk images. Immutable per version -- index.html appends ?v=<version>
    # and a new build always gets a new version -- so they can be cached hard.
    # Without this they carried no Cache-Control at all and a CDN in front would
    # have to guess, which for a 208 MB file means guessing wrong is expensive.
    location /images/v86/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        default_type application/octet-stream;
        try_files $uri =404;
    }

    # The manifest lives in that directory but is the opposite of immutable: it
    # is the file that says which image version is current, so caching it for a
    # year pins clients to whatever tier set was live when they first fetched
    # it. index.html sends `cache: "no-cache"` on the request, which a compliant
    # shared cache must honour, but that protects nothing against a proxy that
    # drops client directives -- and nothing at all on the web-root path below,
    # which no request of ours annotates. Exact matches beat prefix matches, so
    # this wins over /images/v86/ regardless of order.
    location = /images/v86/vm-images.json {
        add_header Cache-Control "no-cache" always;
        default_type application/json;
        try_files $uri =404;
    }

    # The same file, served through the web-root hard link kept for older paths.
    location = /vm-images.json {
        add_header Cache-Control "no-cache" always;
        default_type application/json;
        try_files $uri =404;
    }

    # CheerpX disk images. HttpBytesDevice streams them over HTTP Range and
    # refuses to initialise unless the response carries Last-Modified or ETag;
    # nginx emits both for static files, so this block only needs to not get in
    # the way. They are immutable per version, hence the long max-age.
    location /images/cheerpx/ {
        add_header Cross-Origin-Resource-Policy "same-origin" always;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        default_type application/octet-stream;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name avirads.com www.avirads.com;
    return 301 https://fapstaff.com$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name avirads.com www.avirads.com;

    ssl_certificate /etc/letsencrypt/live/avirads.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/avirads.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    return 301 https://fapstaff.com$request_uri;
}
