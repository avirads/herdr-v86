#!/bin/sh
set -eu

usage() {
  cat <<'EOF'
usage: cline [--provider NAME] [--model MODEL] [--session ID] TASK...
       cline continue [options] TASK...
       cline status|stop|reset
       cline yolo on|off

Runs the official Cline browser-compatible agent runtime against the current
guest project directory. The runtime and model stay in the browser tab.
EOF
  exit "${1:-0}"
}

provider=''
model=''
session=''
command='cline'

case "${1:-}" in
  -h|--help) usage 0 ;;
  status) command=cline_status; shift ;;
  stop) command=cline_stop; shift ;;
  reset) command=cline_reset; shift ;;
  yolo) command=cline_yolo; shift; [ "$#" -eq 1 ] || usage 2 ;;
  continue) command=cline_continue; shift ;;
esac

while [ "$#" -gt 0 ]; do
  case "$1" in
    --provider) [ "$#" -ge 2 ] || usage 2; provider=$2; shift 2 ;;
    --model) [ "$#" -ge 2 ] || usage 2; model=$2; shift 2 ;;
    --session) [ "$#" -ge 2 ] || usage 2; session=$2; shift 2 ;;
    --) shift; break ;;
    -*) usage 2 ;;
    *) break ;;
  esac
done

case "$command" in
  cline_status|cline_stop|cline_reset) value='' ;;
  cline_yolo) value=$1 ;;
  *) [ "$#" -gt 0 ] || usage 2; value=$* ;;
esac

route=$(jq -cn --arg provider "$provider" --arg model "$model" --arg sessionId "$session" \
  '{provider:$provider,model:$model,sessionId:$sessionId}')
cwd=$(pwd)

encode() { printf %s "$1" | base64 | tr -d '\n'; }
request_id="cline-$(date +%s)-$$"
printf '__V86RPC__\tAGENT_%s\t%s\t%s\t%s\t%s\n' \
  "$(printf %s "$command" | tr '[:lower:]' '[:upper:]')" "$request_id" \
  "$(encode "$value")" "$(encode "$cwd")" "$(encode "$route")" > /dev/ttyS0
echo '[cline] submitted to the ready browser agent.'
