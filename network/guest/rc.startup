#!/bin/sh
mount -t proc proc /proc 2>/dev/null
mount -t sysfs sys /sys 2>/dev/null
mount -t devtmpfs dev /dev 2>/dev/null
mkdir -p /dev/pts /dev/shm
mount -t devpts devpts /dev/pts 2>/dev/null
mount -t tmpfs -o mode=1777 tmpfs /tmp 2>/dev/null
mount -t tmpfs tmpfs /run 2>/dev/null
mkdir -p /mnt/host-transfer
# v86's empty host-backed VirtIO 9P filesystem is the binary file-transfer
# channel. Boot remains compatible with builds that omit the device.
mount -t 9p host9p /mnt/host-transfer \
  -o trans=virtio,version=9p2000.L,cache=loose 2>/dev/null || true
hostname vm
# Level 4 keeps KERN_ERR visible on the console: the browser page watches
# serial output for "lost interrupt" / "I/O error" to auto-restart into
# compatibility boot, so ATA errors must not be silenced (n 1 hid them).
dmesg -n 4 2>/dev/null || true

# Perf tuning for the emulated CPU: disk writes are never persisted across
# reloads, so let dirty pages sit in RAM instead of paying emulated ATA I/O,
# never swap, and skip atime updates on the root filesystem.
echo 80 > /proc/sys/vm/dirty_ratio 2>/dev/null || true
echo 50 > /proc/sys/vm/dirty_background_ratio 2>/dev/null || true
echo 6000 > /proc/sys/vm/dirty_expire_centisecs 2>/dev/null || true
echo 0 > /proc/sys/vm/swappiness 2>/dev/null || true
mount -o remount,noatime / 2>/dev/null || true

# Networking starts at Essentials (tier level 2). Barebones deliberately keeps
# the NIC down; later tiers remain non-blocking when no gateway is available.
tier_level="$(cat /etc/vmvm/tier-level 2>/dev/null || echo 1)"
if [ "$tier_level" -ge 2 ]; then
  ip link set lo up 2>/dev/null || true
  ip link set eth0 up 2>/dev/null || true
  # The public /ide/ reverse proxy has a stable guest target. A fixed address
  # also avoids DHCP lease changes when v86 generates a new NIC MAC on boot.
  ip address replace 10.77.0.15/24 dev eth0 2>/dev/null || true
  ip route replace default via 10.77.0.1 dev eth0 2>/dev/null || true
  printf 'nameserver 10.77.0.1\n' > /etc/resolv.conf
fi

# The Dev and Star tiers are appliance-style development images: compile and
# serve their starter automatically while the interactive shell remains usable.
case "$(cat /etc/vmvm/tier 2>/dev/null)" in
dev|star)
  if [ -x /usr/local/bin/vmbro-dev ]; then
  # Let init spawn the serial getty first. On slower browsers, starting the
  # compiler immediately can starve the shell-prompt event that completes the
  # host page's boot overlay.
    (sleep 5; cd /root/project && PORT=3000 /usr/local/bin/vmbro-dev >/var/log/vmbro-dev.log 2>&1) &
  fi
  ;;
esac
