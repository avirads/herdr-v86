#!/bin/sh
set -eu

PATH="/usr/local/bin:/usr/bin:/bin"
export PATH

# Dev IDE supervisor: serves the browsercode-style IDE shell and its /api/*
# routes on port 3000 (the public /ide/ reverse-proxy target), while running
# the scaffolded app server on its own port (3100, the /preview/ target).
#
# First boot scaffolds /root/project from /opt/vmbro/templates/<framework>,
# then builds (esbuild bundles + Astro render) and starts the app server.
project="${1:-/root/project}"
port="${PORT:-3000}"

exec vmbro-httpd \
  --supervise "$project" \
  --templates /opt/vmbro/templates \
  --app-port 3100 \
  --root /opt/vmbro/ide \
  --bind 0.0.0.0 \
  --port "$port"
