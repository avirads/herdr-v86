#!/bin/sh
set -eu
case "${1:-}" in -h|--help) echo 'usage: vmexport FILE'; echo 'Download one guest file through the browser (maximum 8 MiB).'; exit 0;; esac
[ "$#" -eq 1 ] && [ -f "$1" ] || { echo 'usage: vmexport FILE' >&2; exit 2; }
size=$(wc -c < "$1")
[ "$size" -le 8388608 ] || { echo 'vmexport: files are limited to 8 MiB' >&2; exit 1; }
b64() { printf %s "$1" | base64 | tr -d '\n'; }
id="$$-$(date +%s)"
mount | grep -q ' /mnt/host-transfer ' ||
  { echo 'vmexport: binary host-transfer channel is unavailable' >&2; exit 1; }
safe_name=$(basename "$1" | tr -c 'A-Za-z0-9._-' '_')
shared_name="export-${id}-${safe_name}"
cp "$1" "/mnt/host-transfer/$shared_name"
printf '__V86RPC__\tEXPORT9P\t%s\t%s\t%s\n' \
  "$id" "$(b64 "$(basename "$1")")" "$(b64 "$shared_name")" > /dev/tty
# The browser reads immediately after receiving the small RPC marker. Keep the
# shared inode briefly to cover a busy host, then reclaim it asynchronously.
(sleep 30; rm -f "/mnt/host-transfer/$shared_name") >/dev/null 2>&1 &
