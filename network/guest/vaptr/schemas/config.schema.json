{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vmvapt/schemas/config.schema.json",
  "title": "ScanConfig",
  "description": "Operator-authored scan configuration (configs/*.json)",
  "type": "object",
  "required": ["target", "targets", "scope"],
  "additionalProperties": false,
  "properties": {
    "target": { "type": "string", "minLength": 1 },
    "targets": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "workspace": { "type": "string" },
    "scope": {
      "type": "object",
      "required": ["authorization"],
      "properties": {
        "allowed_domains": { "type": "array", "items": { "type": "string" } },
        "allow_subdomains": { "type": "boolean" },
        "allowed_cidrs": { "type": "array", "items": { "type": "string" } },
        "allow_private": { "type": "boolean" },
        "allow_wildcard": { "type": "boolean" },
        "rate_limit": { "type": "integer", "minimum": 0 },
        "max_concurrency": { "type": "integer", "minimum": 0 },
        "authorization": { "type": "string", "minLength": 1 }
      },
      "anyOf": [
        { "required": ["allowed_domains"], "properties": { "allowed_domains": { "minItems": 1 } } },
        { "required": ["allowed_cidrs"], "properties": { "allowed_cidrs": { "minItems": 1 } } }
      ]
    },
    "llm": {
      "type": "object",
      "properties": {
        "provider": { "enum": ["none", "vmllm", "command", "local", "openai", "anthropic"] },
        "model": { "type": "string" },
        "base_url": { "type": "string" },
        "api_key_env": { "type": "string" },
        "command": { "type": "string", "description": "CLI for the vmllm/command providers (default vmllm)" },
        "max_tokens": { "type": "integer", "minimum": 1 }
      }
    },
    "oast": {
      "type": "object",
      "description": "Self-hosted interactsh server for out-of-band (blind vuln) confirmation",
      "properties": {
        "server": { "type": "string", "description": "interactsh base URL, e.g. https://oast.fapstaff.com" },
        "token_env": { "type": "string", "description": "env var holding the interactsh auth token" }
      }
    },
    "fingerprint": {
      "type": "object",
      "description": "Fingerprint stage backend selection",
      "properties": {
        "backend": { "enum": ["httpx", "native"], "description": "httpx (default) or native (built-in prober, no external tool)" }
      }
    },
    "crawl": {
      "type": "object",
      "description": "Crawl stage backend selection",
      "properties": {
        "backend": { "enum": ["katana", "hakrawler", "gospider", "native"], "description": "crawler to use (default katana)" }
      }
    },
    "content": {
      "type": "object",
      "description": "Content-discovery backend selection",
      "properties": {
        "backend": { "enum": ["ffuf", "native"], "description": "ffuf (default) or native (built-in, no external tool)" }
      }
    },
    "params": {
      "type": "object",
      "description": "Parameter-discovery backend selection",
      "properties": {
        "backend": { "enum": ["ffuf", "native"], "description": "ffuf (default) or native (built-in query fuzzing)" }
      }
    },
    "scan": {
      "type": "object",
      "description": "Vulnerability scan backend selection",
      "properties": {
        "backend": { "enum": ["nuclei", "native"], "description": "nuclei (default, broad) or native (built-in curated checks, no external tool)" }
      }
    }
  }
}
