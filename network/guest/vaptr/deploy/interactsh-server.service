# Self-hosted interactsh OAST server for vmvapt.
# Deploy to /etc/systemd/system/interactsh-server.service on the OAST host.
#
# Binds DNS + HTTP to a SPECIFIC public IP (not 0.0.0.0) so it coexists with a
# systemd-resolved stub (127.0.0.53) and any dnsmasq on other interfaces.
# HTTP runs on :8071 behind nginx (see oast.nginx); -skip-acme because nginx
# terminates TLS. The auth token lives in /opt/interactsh/interactsh.env
# (INTERACTSH_TOKEN=..., mode 600) so it is never in this unit or in git.
#
# Replace 82.180.132.123 / oast.fapstaff.com with your host IP / domain.

[Unit]
Description=vmvapt interactsh OAST server (self-hosted)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
DynamicUser=yes
StateDirectory=interactsh
WorkingDirectory=/var/lib/interactsh
Environment=HOME=/var/lib/interactsh
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
EnvironmentFile=/opt/interactsh/interactsh.env
ExecStart=/opt/interactsh/interactsh-server \
  -domain oast.fapstaff.com \
  -ip 82.180.132.123 \
  -listen-ip 82.180.132.123 \
  -dns-port 53 \
  -http-port 8071 \
  -skip-acme \
  -origin-ip-header X-Forwarded-For \
  -token ${INTERACTSH_TOKEN} \
  -disable-update-check
Restart=on-failure
RestartSec=3
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
