{
  "id": "/",
  "name": "VMVM — Browser Virtual Machine",
  "short_name": "VMVM",
  "description": "A complete Linux virtual machine, development environment, and local AI toolkit in your browser.",
  "start_url": "/?role=agent",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0d1117",
  "theme_color": "#161b22",
  "categories": ["developer", "productivity", "utilities"],
  "icons": [
    {
      "src": "/assets/vmvm-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/vmvm-logo.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/vmvm-icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Open VMVM",
      "short_name": "VMVM",
      "url": "/?role=agent",
      "icons": [{ "src": "/assets/vmvm-icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Remote agent",
      "short_name": "Remote",
      "url": "/?role=human",
      "icons": [{ "src": "/assets/vmvm-icon-192.png", "sizes": "192x192" }]
    }
  ]
}
