agent/node_modules/
# Root npm install (CheerpX runtime). Needed here since the root
# package-lock.json arrived with the vmbro port -- an npm install at the root
# now produces a node_modules/ that agent/node_modules/ does not cover.
node_modules/
portable/dist/
portable/vm-launcher.exe
network/v86net-gateway-userspace-test.exe

# Large WebGPU model, hardlinked/copied in locally for e2e benchmarks
models/

# VAPT external-tool binaries: build inputs for the abandoned all-tools image,
# not shipped in the native-only vapt tier (vaptr is self-contained).
network/guest/vapt-bin/
network/guest/vaptr-all-tools.json

# Go gateway build artifact (linux/amd64), rebuilt per deploy
network/v86net-gateway-linux-amd64

network/guest/vmbro-httpd/vmbro-httpd-linux-386

build-dev.log


# v86 disk images: build artifacts, not sources. Reproducible with
# network/guest/build-tier-images.sh and published by uploading to the server,
# not by committing them. Tracked here until 2026-08-13; seven of the eight
# were raw blobs of 67-104 MB against GitHub's 100 MB hard limit, and the
# eighth (vm-star) had already been pushed into Git LFS to get under it.
#
# They were also stale: this repo carried vm-ai-tools at 92,274,688 bytes while
# the live tier is 159,383,552. The 64 MiB of headroom every tier now carries
# landed after they were committed, so anything deploying from git was shipping
# images that no longer matched production.
#
# A fresh clone therefore has vm-images.json but no images. Build or fetch them.
images/v86/*.img
# The previous build, kept beside the new one so a deploy can be rolled back
# without re-fetching from the serving host.
images/v86/*.img.old
*.ext2

# The rescued star image is committed compressed, because the raw 128 MiB file
# exceeds GitHub's 100 MB hard limit. Decompress with:
#   gunzip -k rescued-from-production/images/vm-star-i386-ext4.img.gz
# and the result must not be committed back.
rescued-from-production/images/*.img

# CheerpX build artifacts and optional payloads, matching the other tree.
# The .ext2 is built by images/cheerpx/build-ext2.sh, not committed.
images/cheerpx/*.ext2
# 18.7 MB Tailscale blob, fetched only by TailscaleNetwork which this app never
# constructs (the CheerpX guest has no network interface at all). Restore with
# vendor/cheerpx/fetch.sh if Tailscale networking is ever wired up.
vendor/cheerpx/*/tun/tailscale.wasm
