{
  "manifest_version": 3,
  "name": "AutoBro Web Bridge",
  "version": "0.5.0",
  "description": "Browser-native automation bridge with optional no-admin local VM networking.",
  "key": "",
  "permissions": ["activeTab", "alarms", "debugger", "nativeMessaging", "notifications", "scripting", "storage", "tabs", "sidePanel"],
  "side_panel": { "default_path": "panel/panel.html" },
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "http://127.0.0.1/*",
      "https://fapstaff.com/*"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:* wss://*/* https://*/*"
  },
  "cross_origin_embedder_policy": { "value": "require-corp" },
  "cross_origin_opener_policy": { "value": "same-origin" },
  "icons": { "128": "icon128.png" },
  "action": {
    "default_title": "AutoBro Web Bridge",
    "default_icon": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
