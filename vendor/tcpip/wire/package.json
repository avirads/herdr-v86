{
  "name": "@tcpip/wire",
  "version": "0.1.4",
  "description": "Wire protocol utilities for tcpip.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/chipmk/tcpip.js.git",
    "directory": "packages/wire"
  },
  "main": "dist/index.cjs",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist/**/*"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.cjs"
    }
  },
  "dependencies": {},
  "devDependencies": {
    "@total-typescript/tsconfig": "^1.0.4",
    "tsup": "^8.3.5",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  },
  "scripts": {
    "build": "tsup --clean",
    "clean": "rm -rf dist",
    "test": "vitest"
  }
}